# PostgreSQL
POSTGRES_USER=iis_user
POSTGRES_PASSWORD=iis_password
POSTGRES_DB=iis_db

# Neo4j
NEO4J_PASSWORD=neo4jpassword

# MinIO (local dev object storage; swap for AWS S3 credentials in production)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# USB + face + PIN authentication gate (see backend/src/auth/biometric-crypto.util.ts).
# BIOMETRIC_ENCRYPTION_KEY encrypts stored face embeddings at rest - rotate in production.
# FACE_MATCH_THRESHOLD is the minimum cosine similarity to accept a live face as a match;
# tune against whatever embedding model the frontend actually uses (Day 2).
BIOMETRIC_ENCRYPTION_KEY=change-me-in-production
FACE_MATCH_THRESHOLD=0.75

# Where the gate sends the browser after a successful face+PIN check, instead
# of this project's own dashboard - a separate app's SSO-receiving URL. Same
# #token=...&user=... handoff format as SsoCallbackPage.tsx. On a LAN demo,
# set this to that machine's LAN IP (e.g. http://10.0.0.5:3001/sso-callback),
# not localhost - localhost here resolves on whichever PC's browser is
# actually loading the gate page, not on the machine hosting this stack.
GATE_HANDOFF_URL=http://localhost:3001/sso-callback

# Service-to-service auth between the ai-service and the NestJS backend
# (extraction-results callback). Not a user credential - rotate independently.
INTERNAL_SERVICE_KEY=change-me-in-production

# ai-service feature flags
ENABLE_TRANSFORMER_NER=true

# Multilingual (Hindi/regional-language) NLP - see ai-service/app/nlp/gemini_extraction.py.
# Get a free key at aistudio.google.com. Blank = English-only pipeline, unchanged.
ENABLE_MULTILINGUAL_NLP=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Kafka (introduced in Phase 2)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Permissioned ledger (Phase 8) - set to false to run without the Fabric
# network up; the app degrades gracefully (audit logs still write to Postgres,
# just without a ledger anchor). See blockchain/README.md to bring it up.
LEDGER_ENABLED=true

# Airflow (Phase 9)
AIRFLOW_ADMIN_PASSWORD=admin
